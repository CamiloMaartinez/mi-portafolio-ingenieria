---
const meta = {
  codigo: "COD. PROYECTO: STRUCT-CIVIL-2025",
  norma: "NORMA SÍSMICA • ACI 318 • AISC 360",
};

const stats = [
  { value: "+15 Años", label: "Experiencia en campo" },
  { value: "50+", label: "Proyectos ejecutados" },
  { value: "100%", label: "Rigor técnico" },
];
---

<section
  id="inicio"
  class="relative w-full min-h-screen flex flex-col justify-between overflow-hidden bg-antracita"
>
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero-obra.jpg"
      alt="Estructura de hormigón armado y construcción civil"
      class="w-full h-full object-cover object-center brightness-[0.42] contrast-125 grayscale-[35%]"
    />
    <div
      class="absolute inset-0 bg-linear-to-tr from-antracita via-antracita/80 to-transparent"
    >
    </div>
    <div
      class="absolute inset-0 bg-linear-to-r from-antracita via-antracita/60 to-transparent"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.04] pointer-events-none"
      style="background-size: 40px 40px; background-image: linear-gradient(to right, #fff 1px, transparent 1px), linear-gradient(to bottom, #fff 1px, transparent 1px);"
    >
    </div>
  </div>

  <div
    class="px-4 md:px-12 lg:px-16 pt-28 md:pt-40 pb-10 md:pb-32 flex flex-col justify-center relative z-10 my-auto max-w-7xl w-full"
  >
    <div class="hero-tag flex items-center gap-2.5 md:gap-3 mb-4 md:mb-6">
      <span class="inline-block w-4 md:w-6 h-[2px] bg-seguridad"></span>
      <span
        class="text-[11px] md:text-sm font-semibold tracking-wider md:tracking-widest uppercase text-white/70"
      >
        Consultoría & Cálculo Estructural
      </span>
    </div>

    <div class="relative w-fit max-w-full">
      <div
        class="hero-block clip-diagonal bg-seguridad p-4 sm:p-6 md:p-9 lg:p-11 w-fit max-w-4xl shadow-2xl border-l-4 border-white/20"
      >
        <h1
          class="font-display font-black text-4xl sm:text-6xl md:text-7xl lg:text-8xl leading-none text-antracita uppercase tracking-tight m-0 select-none"
        >
          Ingeniería Estructural<br class="hidden sm:inline" /> & Construcción
        </h1>
      </div>
    </div>

    <p
      class="hero-sub font-sans text-sm sm:text-base md:text-xl lg:text-2xl text-white/90 mt-5 md:mt-8 max-w-md md:max-w-2xl font-light leading-relaxed"
    >
      Soluciones técnicas de alto rendimiento para proyectos de
      infraestructura, comerciales y residenciales.
    </p>

    <div
      class="hero-meta mt-4 md:mt-8 flex flex-wrap items-center gap-x-4 gap-y-1 text-[10px] md:text-xs text-white/50 tracking-wider font-mono"
    >
      <div class="flex items-center gap-1.5 md:gap-2">
        <span class="w-1.5 h-1.5 bg-seguridad"></span>
        <span>{meta.codigo}</span>
      </div>
      <span class="text-white/20 hidden sm:inline">|</span>
      <div>{meta.norma}</div>
    </div>
  </div>

  <div
    class="hero-strip w-full z-20 border-t border-white/20 bg-antracita/90 backdrop-blur-md"
  >
    <div class="max-w-7xl mx-auto grid grid-cols-3 divide-x divide-white/20">
      {
        stats.map((s) => (
          <div class="px-2.5 sm:px-6 md:px-10 lg:px-12 py-3.5 sm:py-6 flex flex-col justify-center hover:bg-white/[0.03] transition-colors group">
            <span class="font-display font-black text-2xl sm:text-4xl lg:text-5xl text-seguridad leading-none group-hover:scale-105 transition-transform origin-left">
              {s.value}
            </span>
            <p class="font-sans text-[9px] sm:text-xs md:text-sm text-white/70 uppercase tracking-tight sm:tracking-widest mt-1 md:mt-2 font-medium leading-tight">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero-tag {
    animation: fade-down 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }
  .hero-block {
    animation: slide-in 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }
  .hero-sub {
    animation: fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;
  }
  .hero-meta {
    animation: fade-in 0.5s ease-out 0.7s both;
  }
  .hero-strip {
    animation: rise-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.9s both;
  }

  @keyframes fade-down {
    from {
      opacity: 0;
      transform: translateY(-1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateX(-110%);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(100%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-tag,
    .hero-block,
    .hero-sub,
    .hero-meta,
    .hero-strip {
      animation: none;
    }
  }
</style>
