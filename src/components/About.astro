---
import { EMAIL_CONTACTO } from "../data/config.js";

const especialidades = [
  "Cálculo Estructural",
  "Dirección de Obra",
  "Patología Estructural",
];
const certificaciones = [
  "Especialización en Estructuras",
  "Diplomado en Interventoría de Obras Civiles",
];
---

<section id="sobre-mi" class="py-16 bg-gray-50">
  <div class="max-w-5xl mx-auto px-4 grid md:grid-cols-2 gap-10 items-center">
    <img
      src="/images/perfil-obra.jpg"
      alt="Ing. Daniel Sandoval en campo"
      class="rounded-2xl w-full max-w-sm mx-auto object-cover shadow-lg"
    />

    <div>
      <h2 class="text-2xl md:text-3xl font-bold text-antracita mb-4">
        Sobre el Ingeniero
      </h2>
      <p class="text-gray-700">
        Ingeniero Civil con más de 10 años de experiencia en diseño estructural,
        dirección de obra e interventoría, con un enfoque riguroso en el
        cumplimiento normativo (NSR-10) y la resolución de retos técnicos en
        terrenos complejos.
      </p>
      <p class="mt-3 text-sm font-semibold text-acero">
        Matrícula Profesional: XXX-XXXXXX &nbsp;·&nbsp; {EMAIL_CONTACTO}
      </p>

      <div class="mt-5">
        <p class="text-sm font-bold text-antracita mb-2">Especialidades</p>
        <div class="flex flex-wrap gap-2">
          {
            especialidades.map((e) => (
              <span class="text-xs bg-antracita text-white px-3 py-1 rounded-full">
                {e}
              </span>
            ))
          }
        </div>
      </div>

      <div class="mt-5">
        <p class="text-sm font-bold text-antracita mb-2">Certificaciones</p>
        <ul class="list-disc list-inside text-sm text-gray-700">
          {certificaciones.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
