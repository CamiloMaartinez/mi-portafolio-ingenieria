---
const stats = [
  { value: "12.000+", label: "m² Construidos" },
  { value: "35", label: "Obras Finalizadas" },
  { value: "10", label: "Años de Experiencia" },
];
---

<section id="inicio" class="relative h-[92vh] min-h-140 overflow-hidden">
  <img
    src="/images/hero-obra.jpg"
    alt="Obra en construcción dirigida por el ingeniero"
    class="absolute inset-0 w-full h-full object-cover"
  />
  <div
    class="absolute inset-0 bg-linear-to-t from-antracita via-antracita/60 to-antracita/20"
  >
  </div>

  <div class="relative h-full max-w-6xl mx-auto px-4 flex items-end pb-24">
    <div
      class="hero-block relative bg-seguridad px-8 py-8 max-w-xl -ml-4 md:ml-0"
    >
      <p class="font-sans text-sm font-semibold text-antracita/80 mb-2">
        Ing. Daniel Sandoval — Ingeniería Civil
      </p>
      <h1
        class="font-display font-black uppercase text-4xl md:text-6xl leading-[0.95] text-antracita"
      >
        Estructuras que sostienen su proyecto
      </h1>

      href="#contacto" class="inline-block mt-6 bg-antracita text-white
      font-semibold px-6 py-3 hover:bg-black transition-colors" > Solicitar
      cotización
    </div>
  </div>
</section>

<div class="absolute bottom-0 left-0 right-0 bg-antracita/90 backdrop-blur">
  <div class="max-w-6xl mx-auto px-4 py-4 flex divide-x divide-white/20">
    {
      stats.map((s) => (
        <div class="flex-1 text-center px-2">
          <p class="font-display text-2xl md:text-3xl font-bold text-seguridad">
            {s.value}
          </p>
          <p class="text-xs text-gray-300">{s.label}</p>
        </div>
      ))
    }
  </div>
</div>

<style>
  .hero-block {
    animation: wipe-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    transform-origin: left;
  }
  @keyframes wipe-in {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-block {
      animation: none;
    }
  }
</style>
