---
const servicios = [
  {
    titulo: "Cálculo Estructural",
    desc: "Diseño y verificación estructural conforme a la normativa vigente.",
  },
  {
    titulo: "Dirección de Obra",
    desc: "Supervisión técnica integral durante todo el proceso constructivo.",
  },
  {
    titulo: "Interventoría",
    desc: "Control técnico, administrativo y financiero de proyectos en ejecución.",
  },
  {
    titulo: "Consultoría",
    desc: "Diagnóstico y asesoría en patologías estructurales y viabilidad técnica.",
  },
];
---

<section id="servicios" class="py-16 bg-gray-50">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-bold text-antracita text-center mb-10">
      Servicios
    </h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        servicios.map((s) => (
          <div class="bg-white rounded-xl p-6 shadow hover:shadow-lg transition-shadow border-t-4 border-estructural">
            <h3 class="font-bold text-lg text-antracita mb-2">{s.titulo}</h3>
            <p class="text-sm text-gray-600">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
