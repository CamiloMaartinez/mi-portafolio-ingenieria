---
import { EMAIL_CONTACTO } from "../data/config.js";

const servicios = [
  {
    codigo: "SRV-01",
    categoria: "Diseño y Análisis",
    nivel: "Alta Complejidad",
    titulo: "Cálculo & Modelado Estructural Sismorresistente",
    descripcion:
      "Diseño estructural integral en concreto armado, acero laminado y secciones compuestas. Modelación matemática no lineal, espectros de aceleración por sitio y control estricto de derivas de entrepiso.",
    matriz: [
      { label: "Alcance principal", valor: "Torres, naves & puentes" },
      { label: "Normativa aplicada", valor: "ACI 318-19 • AISC 360" },
    ],
    herramientas: "ETABS Ultimate • SAP2000 • SAFE",
    entregables: [
      "Memoria de cálculo y análisis modal espectral sellada",
      "Planos estructurales de detalle para taller y armadura",
      "Planillas de cuantificación de acero y cubicaciones de hormigón",
    ],
    tiempo: "Tiempo estimado: 3-6 semanas",
    cta: "Solicitar cotización",
  },
  {
    codigo: "SRV-02",
    categoria: "Diagnóstico y Patología",
    nivel: "Forense",
    titulo: "Peritajes Estructurales & Auditoría Técnica",
    descripcion:
      "Evaluación forense de daños por sismos, asentamientos diferenciales, sobrecargas o corrosión acelerada. Dictamen técnico legal y proyectos ejecutivos de reforzamiento con fibra de carbono (CFRP) o encamisados de acero.",
    matriz: [
      { label: "Metodología de ensayos", valor: "Esclerometría • Ultrasonido" },
      { label: "Normativa rehabilitación", valor: "ACI 562 • FEMA P-58" },
    ],
    herramientas: "Edificaciones existentes & cambios de uso",
    entregables: [
      "Informe pericial certificado de vulnerabilidad y capacidad residual",
      "Alternativas técnico-económicas de consolidación estructural",
      "Firma pericial colegiada para aseguradoras o municipios",
    ],
    tiempo: "Respuesta urgente: < 72 horas",
    cta: "Solicitar peritaje",
  },
  {
    codigo: "SRV-03",
    categoria: "Valor Agregado",
    nivel: "Value Engineering",
    titulo: "Optimización Estructural & Value Engineering",
    descripcion:
      "Revisión de proyectos estructurales existentes de terceros para identificar sobredimensionamientos, optimizar cuantías de acero y aligerar secciones de concreto sin comprometer la seguridad ni el factor normativo.",
    matriz: [
      { label: "Ahorro típico logrado", valor: "12% – 22% en costo de acero" },
      { label: "Tipo de análisis", valor: "Reingeniería de cuantías" },
    ],
    herramientas: "Tarifa fija o bono por ahorro real",
    entregables: [
      "Matriz comparativa de costos y ahorro de volumen por nivel",
      "Re-diseño optimizado con justificación analítica fehaciente",
    ],
    tiempo: "ROI directo inmediato",
    cta: "Evaluar proyecto",
  },
  {
    codigo: "SRV-04",
    categoria: "BIM y Constructibilidad",
    nivel: "Nivel LOD 400",
    titulo: "Modelado BIM Estructural & Dirección Técnica",
    descripcion:
      "Integración de estructuras en entornos Revit y Tekla Structures con detección paramétrica de interferencias con MEP e hidrosanitarias. Supervisión directa en obra para asegurar el vaciado y armado conforme a plano.",
    matriz: [
      { label: "Modelado paramétrico", valor: "Revit Structure • Tekla" },
      { label: "Detección de choques", valor: "Navisworks Manage" },
    ],
    herramientas: "Visitas de hito • control de enfierradura",
    entregables: [
      "Modelo federado .IFC / .RVT con detalles de armadura LOD 350-400",
      "Protocolos de liberación técnica de armaduras pre-vaciado",
    ],
    tiempo: "Coordinación multidisciplinar",
    cta: "Consultar servicio",
  },
];

const flujo = [
  {
    fase: "Fase 01",
    titulo: "Recopilación & Criterios de Diseño",
    desc: "Revisión del estudio de mecánica de suelos, topografía y definición de coeficientes sísmicos de sitio (norma local e internacional).",
  },
  {
    fase: "Fase 02",
    titulo: "Modelado Matemático & Análisis Dinámico",
    desc: "Simulación computacional tridimensional, análisis P-Delta, vibraciones inducidas y distribución de esfuerzos principales.",
  },
  {
    fase: "Fase 03",
    titulo: "Planos Ejecutivos & Memoria de Cálculo",
    desc: "Planos constructivos con armaduras exactas, especificaciones técnicas de materiales y memoria explicativa para tramitación de licencias.",
  },
  {
    fase: "Fase 04",
    titulo: "Supervisión en Terreno & Liberación",
    desc: "Inspección de zapatas, cabezales, columnas y losas antes del colado para garantizar el 100% de apego al proyecto estructural.",
  },
];
---

<section id="servicios" class="bg-antracita text-white">
  <div class="px-4 md:px-12 lg:px-16 pt-16 pb-10 border-b border-acero/40">
    <div
      class="flex items-center gap-2 font-mono text-[11px] tracking-widest text-white/50 uppercase mb-3"
    >
      <span class="inline-block w-1.5 h-1.5 bg-seguridad"></span>
      <span>Capacidad Técnica • Metodología</span>
    </div>

    <div class="inline-block bg-seguridad px-5 py-2.5 mb-4 clip-diagonal">
      <h2
        class="font-display font-black text-3xl sm:text-4xl text-antracita tracking-tight uppercase leading-none"
      >
        Servicios & Especialidades
      </h2>
    </div>

    <p class="text-white/80 font-light text-sm leading-relaxed max-w-xl">
      Ingeniería consultiva de alto rigor técnico orientada a la seguridad
      sismorresistente, optimización volumétrica de materiales y viabilidad
      constructiva integral bajo normativas internacionales.
    </p>
  </div>

  <div class="px-4 md:px-12 lg:px-16 py-10 flex flex-col gap-8 max-w-3xl mx-auto w-full">
    {
      servicios.map((s) => (
        <article class="border border-acero/60 bg-[#1c1b20] relative p-5">
          <div class="flex items-center justify-between border-b border-acero/40 pb-3 mb-4">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 bg-seguridad" />
              <span class="font-mono text-xs font-bold tracking-widest text-seguridad">
                {s.codigo}
              </span>
              <span class="text-white/40 font-mono text-xs">/</span>
              <span class="font-mono text-[11px] text-white/60 uppercase">
                {s.categoria}
              </span>
            </div>
            <span class="font-mono text-[10px] text-white/40 uppercase">
              {s.nivel}
            </span>
          </div>

          <h3 class="font-display font-black text-2xl sm:text-3xl text-white tracking-wide uppercase leading-tight mb-2">
            {s.titulo}
          </h3>

          <p class="text-white/75 text-xs sm:text-sm font-light leading-relaxed mb-5">
            {s.descripcion}
          </p>

          <div class="grid grid-cols-2 gap-2 p-3 bg-antracita border border-acero/40 font-mono text-[11px] mb-5">
            {s.matriz.map((m) => (
              <div>
                <span class="text-white/45 block text-[9px] uppercase tracking-wider mb-0.5">
                  {m.label}
                </span>
                <span class="text-seguridad font-medium">{m.valor}</span>
              </div>
            ))}
            <div class="col-span-2 pt-2 border-t border-acero/30 flex justify-between items-center">
              <span class="text-white/45 text-[9px] uppercase tracking-wider">
                Detalle
              </span>
              <span class="text-white/80 text-[10px]">{s.herramientas}</span>
            </div>
          </div>

          <div class="mb-5">
            <span class="block font-mono text-[10px] tracking-widest text-white/50 uppercase mb-2">
              Entregables incluidos:
            </span>
            <ul class="space-y-1.5 font-mono text-[11px] text-white/80">
              {s.entregables.map((e) => (
                <li class="flex items-start gap-2">
                  <span class="text-seguridad font-bold">›</span>
                  <span>{e}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-3 border-t border-acero/40 flex items-center justify-between gap-3">
            <span class="font-mono text-[10px] text-white/50">{s.tiempo}</span>
            <a
              href="#contacto"
              class="font-mono text-xs text-seguridad hover:text-white flex items-center gap-1 font-semibold uppercase tracking-wider shrink-0"
            >
              {s.cta} →
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <div class="px-4 md:px-12 lg:px-16 py-10 border-y border-acero/50 bg-[#151417]">
    <div class="max-w-3xl mx-auto">
      <div
        class="flex items-center gap-2 font-mono text-[10px] tracking-widest text-seguridad uppercase mb-2"
      >
        <span class="w-1.5 h-1.5 bg-seguridad"></span>
        <span>Protocolo de Ingeniería</span>
      </div>
      <h3 class="font-display font-black text-2xl text-white uppercase tracking-wider mb-6">
        Flujo de Trabajo Estructural
      </h3>

      <div class="space-y-4">
        {
          flujo.map((f, i) => (
            <div
              class:list={[
                "pl-4 py-1 border-l-2",
                i === 0 ? "border-seguridad" : "border-acero",
              ]}
            >
              <div
                class:list={[
                  "font-mono text-[10px] font-bold",
                  i === 0 ? "text-seguridad" : "text-white/50",
                ]}
              >
                {f.fase}
              </div>
              <div class="font-display font-black text-lg uppercase text-white">
                {f.titulo}
              </div>
              <p class="text-white/60 text-xs font-light mt-1">{f.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="px-4 md:px-12 lg:px-16 py-10 max-w-3xl mx-auto w-full">
    <div class="border-2 border-seguridad bg-[#1a191e] p-5 relative overflow-hidden">
      <div
        class="absolute top-0 right-0 bg-seguridad text-antracita font-mono text-[10px] font-bold px-2 py-0.5 uppercase tracking-wider"
      >
        Consultoría Directa
      </div>

      <span class="font-mono text-[10px] text-seguridad uppercase tracking-widest block mb-1">
        • Consultoría Directa
      </span>
      <h3 class="font-display font-black text-2xl sm:text-3xl text-white uppercase tracking-tight mb-2 leading-none">
        ¿Requieres validar o diseñar una estructura?
      </h3>
      <p class="text-white/75 text-xs sm:text-sm font-light leading-relaxed mb-5">
        Evaluación de viabilidad, optimización de acero y modelado con
        estricto apego a normativa. Respuesta y diagnóstico preliminar en 24 a
        48 horas.
      </p>

      <a
        href={`mailto:${EMAIL_CONTACTO}`}
        class="block w-full text-center bg-seguridad hover:bg-orange-600 text-antracita font-display font-black text-lg sm:text-xl py-3 tracking-wider uppercase transition-colors"
      >
        Solicitar Propuesta Técnica →
      </a>
    </div>
  </div>
</section>
