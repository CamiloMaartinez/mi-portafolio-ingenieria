---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Gallery from "../../components/Gallery.jsx";
import proyectos from "../../data/projects.json";

export function getStaticPaths() {
  return proyectos.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout
  title={project.nombre + " | Ing. Daniel Sandoval"}
  description={project.descripcion}
  image={project.fotos?.[0]?.url}
>
  <Navbar />

  <main class="pt-28 pb-20 bg-papel min-h-screen">
    <div class="max-w-5xl mx-auto px-4">
      <a
        href="/#portafolio"
        class="text-sm font-semibold text-antracita hover:text-seguridad"
      >
        ← Volver al portafolio
      </a>

      <div class="mt-4 grid md:grid-cols-2 gap-10">
        <Gallery client:load fotos={project.fotos} />

        <div>
          <span
            class="inline-block bg-seguridad text-antracita text-xs font-bold px-2 py-1"
          >
            {project.categoria}
          </span>
          <h1
            class="font-display text-3xl md:text-4xl font-bold text-antracita mt-2"
          >
            {project.nombre}
          </h1>
          <p class="text-gray-600 mt-1">
            {project.ubicacion} · {project.anio} · {project.duracion}
          </p>
          <p class="text-sm font-semibold text-acero mt-1">
            Rol: {project.rol}
          </p>

          <p class="mt-4 text-gray-700">{project.descripcion}</p>

          <div
            class="relative mt-6 bg-antracita text-white p-5 overflow-hidden"
          >
            <span class="absolute inset-y-0 left-0 w-1.5 bg-seguridad"></span>
            <p class="font-display font-bold text-seguridad text-sm mb-1">
              Reto Técnico Superado
            </p>
            <p class="text-sm text-gray-200">{project.reto_tecnico}</p>
          </div>

          <div
            class="mt-6 grid grid-cols-3 gap-4 text-center border-t border-antracita/15 pt-6"
          >
            <div>
              <p class="font-display text-xl font-bold text-antracita">
                {project.ficha_tecnica.area_m2} m²
              </p>
              <p class="text-xs text-gray-500">Área</p>
            </div>
            <div>
              <p class="font-display text-xl font-bold text-antracita">
                {project.ficha_tecnica.niveles}
              </p>
              <p class="text-xs text-gray-500">Niveles</p>
            </div>
            <div>
              <p class="font-display text-sm font-bold text-antracita">
                {project.ficha_tecnica.tipo_estructura}
              </p>
              <p class="text-xs text-gray-500">Estructura</p>
            </div>
          </div>

          <div class="mt-6 flex flex-wrap gap-2">
            {
              project.servicios.map((s) => (
                <span class="text-xs bg-antracita text-white px-3 py-1">
                  {s}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
